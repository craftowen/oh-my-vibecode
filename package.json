{
  "name": "oh-my-vibecode",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "bun run --cwd apps/web setup",
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "typecheck": "bun run --cwd apps/web typecheck",
    "check": "bun run --cwd apps/web check",
    "test": "bun run --cwd apps/web test",
    "deploy": "bun run --cwd apps/web deploy",
    "cf-typegen": "bun run --cwd apps/web cf-typegen",
    "db:generate": "bun run --cwd packages/db generate",
    "db:migrate:local": "bun run --cwd apps/web db:migrate:local",
    "db:migrate:remote": "bun run --cwd apps/web db:migrate:remote"
  }
}
